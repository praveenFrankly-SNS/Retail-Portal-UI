# ============================================================
# Retail AI Portal — Frontend Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# Backend API URL
# The FastAPI backend runs on port 8000 by default.
VITE_API_URL=http://localhost:8000

# Application data mode: "live" (use backend APIs) or "mock" (offline demo data)
# In live mode the frontend calls the FastAPI backend which calls Databricks.
# In mock mode the frontend returns pre-built static data without any API calls.
VITE_APP_DATA_MODE=live

# Application display name (shown in page title)
VITE_APP_NAME=Retail AI Portal

# Optional: Analytics / monitoring instrumentation key
# VITE_INSTRUMENTATION_KEY=
