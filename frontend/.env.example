# ============================================================
# Retail AI Portal — Frontend Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# Backend API URL
# The FastAPI backend runs on port 8000 by default.
VITE_API_URL=http://localhost:8000

# Enable live Databricks backend API calls.
# Set to "true" to use live Databricks Model Serving for recommendations.
# Set to "false" to use built-in mock/fallback data (offline demo mode).
VITE_ENABLE_LIVE_API=true

# Application display name (shown in page title)
VITE_APP_NAME=Retail AI Portal

# Optional: Analytics / monitoring instrumentation key
# VITE_INSTRUMENTATION_KEY=
