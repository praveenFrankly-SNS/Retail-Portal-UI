# ============================================================
# Retail AI Portal — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit .env to version control.
# ============================================================

# ── Databricks Workspace ─────────────────────────────────────
# Your workspace URL (with or without https://)
DATABRICKS_HOST=your-workspace.azuredatabricks.net

# Personal Access Token or OAuth token
# Generate in: User Settings → Access Tokens
DATABRICKS_TOKEN=your-personal-access-token

# ── Product Search (Vector Search) ───────────────────────────
# Vector Search endpoint name (created by the Product Search accelerator)
VECTOR_SEARCH_ENDPOINT=product_search_vs_endpoint

# Primary product catalog vector index
VECTOR_SEARCH_INDEX_NAME=product_search_dev.gold.product_search_catalog_index

# SQL Warehouse for catalog queries
SQL_WAREHOUSE_ID=your-sql-warehouse-id

# ── Unity Catalog ────────────────────────────────────────────
UNITY_CATALOG_NAME=product_search_dev
UNITY_SCHEMA_NAME=gold

# ── Product Recommendation Accelerator ───────────────────────
# Databricks Model Serving endpoint name for recommendations
# This is the endpoint deployed by the Product Recommendation accelerator.
# Example: "product-recommendation-dev" or "retail-recommendation-endpoint"
RECOMMENDATION_ENDPOINT=product-recommendation-dev

# ── LLM & Embedding Models (Databricks Foundation Model APIs) ─
LLM_ENDPOINT=databricks-meta-llama-3-1-70b-instruct
EMBEDDING_MODEL_ENDPOINT=databricks-bge-large-en

# ── Application ──────────────────────────────────────────────
APP_NAME=Retail AI Portal
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# ── API Server ───────────────────────────────────────────────
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ── Security ─────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# ── Cache (Optional — Redis) ──────────────────────────────────
CACHE_ENABLED=False
CACHE_TTL_SECONDS=3600
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Search Tuning ─────────────────────────────────────────────
MAX_QUERY_LENGTH=200
MAX_RESULTS_PER_PAGE=50
DEFAULT_PAGE_SIZE=20
VECTOR_SEARCH_TOP_K=100
SIMILARITY_THRESHOLD=0.5

# ── Performance ───────────────────────────────────────────────
DATABRICKS_CONNECTION_TIMEOUT=30
DATABRICKS_READ_TIMEOUT=60
MAX_CONCURRENT_REQUESTS=10

# ── Monitoring ────────────────────────────────────────────────
ENABLE_METRICS=True
METRICS_PORT=9090
ENABLE_REQUEST_LOGGING=True
SLOW_QUERY_THRESHOLD_MS=2000
